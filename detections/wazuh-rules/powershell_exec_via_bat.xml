<group name="windows,powershell,">
  <rule id="100001" level="5">
    <!-- Wazuh 4.14: Sysmon Event 1, Process Creation. -->
    <if_sid>61603</if_sid>
    <!-- Match executable basenames, including paths and mixed case. -->
    <field name="win.eventdata.image" type="pcre2">(?i)(?:^|[\\/])powershell\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(?:^|[\\/])cmd\.exe$</field>
    <!-- Batch suffix boundary; also allow an escaped quote in Windows event data.
         This is a command-line heuristic, not a complete cmd.exe parser. -->
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)\.bat(?=$|[\s"&amp;|&lt;&gt;]|\\")</field>
    <description>PowerShell Execution via a BAT File</description>
    <mitre>
      <id>T1059.001</id> <!-- PowerShell -->
      <id>T1059</id> <!-- Command and Scripting Interpreter -->
    </mitre>
    <options>no_full_log</options>
  </rule>
</group>
