#!/bin/bash
set -euo pipefail
umask 077

# Credentials generated by the assistant stay on the instance, never in Terraform.
install -d -m 700 /opt/wazuh-installation /var/lib/detection-lab
cd /opt/wazuh-installation
curl --fail --silent --show-error --location --retry 5 --retry-delay 5 \
  'https://packages.wazuh.com/${wazuh_branch}/wazuh-install.sh' \
  --output wazuh-install.sh
bash ./wazuh-install.sh -a

for service in wazuh-manager wazuh-indexer wazuh-dashboard; do
  systemctl is-active --quiet "$service"
done
date --iso-8601=seconds > /var/lib/detection-lab/wazuh-bootstrap-complete
